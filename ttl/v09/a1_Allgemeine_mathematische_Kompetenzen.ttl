n0:e6d
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "1.1";
	skos:broader n0:g9c;
	skos:prefLabel "mathematische Kenntnisse, Fertigkeiten und Fähigkeiten bei der Bearbeitung problemhaltiger Aufgaben anwenden,"@de.
n0:z7x
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "1.2";
	skos:broader n0:g9c;
	skos:prefLabel "Lösungsstrategien entwickeln und nutzen (z.B. systematisch probieren),"@de.
n0:s3t
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "1.3";
	skos:broader n0:g9c;
	skos:prefLabel "Zusammenhänge erkennen, nutzen und auf ähnliche Sachverhalte übertragen."@de.
n0:g9c
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "1";
	skos:topConceptOf n0:;
	skos:prefLabel "Problemlösen"@de;
