	skos:notation "2.1";
	skos:broader n0:c5u;
	skos:prefLabel "eigene Vorgehensweisen beschreiben, Lösungswege anderer verstehen und gemeinsam darüber reflektieren,"@de.
n0:u6e
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "2.2";
	skos:broader n0:c5u;
	skos:prefLabel "mathematische Fachbegriffe und Zeichen sachgerecht verwenden,"@de.
n0:p4t
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "2.3";
	skos:broader n0:c5u;
	skos:prefLabel "Aufgaben gemeinsam bearbeiten, dabei Verabredungen treffen und einhalten."@de.
n0:c5u
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "2";
	skos:topConceptOf n0:;
	skos:prefLabel "Kommunizieren"@de;
