n0:x2z
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 1.1";
	skos:broader n0:u2s;
	skos:prefLabel "nennen und beschreiben bedeutsame Stoffe mit ihren typischen Eigenschaften,"@de.
n0:p4f
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 1.2";
	skos:broader n0:u2s;
	skos:prefLabel "beschreiben modellhaft den submikroskopischen Bau ausgewählter Stoffe,"@de.
n0:f9z
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 1.3";
	skos:broader n0:u2s;
	skos:prefLabel "beschreiben den Bau von Atomen mit Hilfe eines geeigneten Atommodells,"@de.
n0:s3h
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 1.4";
	skos:broader n0:u2s;
	skos:prefLabel "verwenden Bindungsmodelle zur Interpretation von Teilchenaggregationen, räumlichen Strukturen und zwischenmolekularen Wechselwirkungen,"@de.
n0:c4s
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 1.5";
	skos:broader n0:u2s;
	skos:prefLabel "erklären die Vielfalt der Stoffe auf der Basis unterschiedlicher Kombinationen und Anordnungen von Teilchen."@de.
n0:u2s
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 1";
	skos:broader n0:x4q;
	skos:prefLabel "Stoff-Teilchen-Beziehungen"@de; 
	skos:definition "Die Schülerinnen und Schüler können..."@de;
	skos:narrower n0:x2z,
		n0:p4f,
		n0:f9z,
		n0:s3h,
		n0:c4s.
n0:r9b
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 2.1";
	skos:broader n0:h6u;
	skos:prefLabel "beschreiben und begründen Ordnungsprinzipien für Stoffe, z.B. mit ihren typischen Eigenschaften oder mit charakteristischen Merkmalen der Zusammensetzung und Struktur der Teilchen,"@de.
n0:c7v
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 2.2";
	skos:broader n0:h6u;
	skos:prefLabel "nutzen ein geeignetes Modell zur Deutung von Stoffeigenschaften auf Teilchenebene,"@de.
n0:t5c
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 2.3";
	skos:broader n0:h6u;
	skos:prefLabel "schließen aus den Eigenschaften der Stoffe auf ihre Verwendungsmöglichkeiten und auf damit verbundene Vor- und Nachteile."@de.
n0:h6u
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 2";
	skos:broader n0:x4q;
	skos:prefLabel "Struktur-Eigenschafts-Beziehungen"@de; 
	skos:definition "Die Schülerinnen und Schüler ..."@de;
	skos:narrower n0:r9b,
		n0:c7v,
		n0:t5c.
n0:s6t
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 3.1";
	skos:broader n0:z2v;
	skos:prefLabel "beschreiben Phänomene der Stoff- und Energieumwandlung bei chemischen Reaktionen,"@de.
n0:z4e
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 3.2";
	skos:broader n0:z2v;
	skos:prefLabel "deuten Stoff- und Energieumwandlungen hinsichtlich der Veränderung von Teilchen und des Umbaus chemischer Bindungen,"@de.
n0:r9r
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 3.3";
	skos:broader n0:z2v;
	skos:prefLabel "kennzeichnen in ausgewählten Donator-Akzeptor-Reaktionen die Übertragung von Teilchen und bestimmen die Reaktionsart,"@de.
n0:p5c
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 3.4";
	skos:broader n0:z2v;
	skos:prefLabel "erstellen Reaktionsschemata/Reaktionsgleichungen durch Anwendung der Kenntnisse über die Erhaltung der Atome und die Bildung konstanter Atomzahlenverhältnisse in Verbindungen,"@de.
n0:v7f
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 3.5";
	skos:broader n0:z2v;
	skos:prefLabel "beschreiben die Umkehrbarkeit chemischer Reaktionen,"@de.
n0:a2h
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 3.6";
	skos:broader n0:z2v;
	skos:prefLabel "beschreiben Beispiele für Stoffkreisläufe in Natur und Technik als Systeme chemischer Reaktionen,"@de.
n0:h7q
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 3.7";
	skos:broader n0:z2v;
	skos:prefLabel "beschreiben Möglichkeiten der Steuerung chemischer Reaktionen durch Variation von Reaktionsbedingungen."@de.
n0:z2v
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 3";
	skos:broader n0:x4q;
	skos:prefLabel "chemische Reaktion"@de; 
	skos:definition "Die Schülerinnen und Schüler ..."@de;
	skos:narrower n0:s6t,
		n0:z4e,
		n0:r9r,
		n0:p5c,
		n0:v7f,
		n0:a2h,
		n0:h7q.
n0:q7u
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 4.1";
	skos:broader n0:d5a;
	skos:prefLabel "geben an, dass sich bei chemischen Reaktionen auch der Energieinhalt des Reaktionssystems durch Austausch mit der Umgebung verändert,"@de.
n0:a5s
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 4.2";
	skos:broader n0:d5a;
	skos:prefLabel "führen energetische Erscheinungen bei chemischen Reaktionen auf die Umwandlung eines Teils der in Stoffen gespeicherten Energie in andere Energieformen zurück,"@de.
n0:r6u
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "E 4.3";
	skos:broader n0:d5a;
	skos:prefLabel "beschreiben die Beeinflussbarkeit chemischer Reaktionen durch den Einsatz von Katalysatoren."@de.
n0:d5a
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F 4";
	skos:broader n0:x4q;
	skos:prefLabel "energetische Betrachtung bei Stoffumwandlungen"@de; 
	skos:definition "Die Schülerinnen und Schüler ..."@de;
	skos:narrower n0:q7u,
		n0:a5s,
		n0:r6u.
n0:x4q
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "F ";
	skos:topConceptOf n0:;
	skos:prefLabel "Fachwissen"@de; 
	skos:definition "Chemische Phänomene, Begriffe, Gesetzmäßigkeiten kennen und Basiskonzepten zuordnen"@de;
	skos:narrower n0:u2s,
		n0:h6u,
		n0:z2v,
		n0:d5a.
n0:e5e
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "E 1";
	skos:broader n0:z6x;
	skos:prefLabel "erkennen und entwickeln Fragestellungen, die mit Hilfe chemischer Kenntnisse und Untersuchungen, insbesondere durch chemische Experimente, zu beantworten sind,"@de.
n0:x4f
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "E 2";
	skos:broader n0:z6x;
	skos:prefLabel "planen geeignete Untersuchungen zur Überprüfung von Vermutungen und Hypothesen,"@de.
n0:s5h
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "E 3";
	skos:broader n0:z6x;
	skos:prefLabel "führen qualitative und einfache quantitative experimentelle und andere Untersuchungen durch und protokollieren diese,"@de.
n0:e6q
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "E 4";
	skos:broader n0:z6x;
	skos:prefLabel "beachten beim Experimentieren Sicherheits- und Umweltaspekte,"@de.
n0:f9a
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "E 5";
	skos:broader n0:z6x;
	skos:prefLabel "erheben bei Untersuchungen, insbesondere in chemischen Experimenten, relevante Daten oder recherchieren sie,"@de.
n0:f3u
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "E 6";
	skos:broader n0:z6x;
	skos:prefLabel "finden in erhobenen oder recherchierten Daten, Trends, Strukturen und Beziehungen, erklären diese und ziehen geeignete Schlussfolgerungen,"@de.
n0:v5x
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "E 7";
	skos:broader n0:z6x;
	skos:prefLabel "nutzen geeignete Modelle (z.B. Atommodelle, Periodensystem der Elemente) um chemische Fragestellungen zu bearbeiten,"@de.
n0:b2r
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "E 8";
	skos:broader n0:z6x;
	skos:prefLabel "zeigen exemplarisch Verknüpfungen zwischen gesellschaftlichen Entwicklungen und Erkenntnissen der Chemie auf."@de.
n0:z6x
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "E ";
	skos:topConceptOf n0:;
	skos:prefLabel "Erkenntnisgewinnung"@de; 
	skos:definition """Experimentelle und andere Untersuchungsmethoden sowie Modelle nutzen.\n\nDie Schülerinnen und Schüler ..."""@de;
	skos:narrower n0:e5e,
		n0:x4f,
		n0:s5h,
		n0:e6q,
		n0:f9a,
		n0:f3u,
		n0:v5x,
		n0:b2r.
n0:x9c
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "K 1";
	skos:broader n0:p4b;
	skos:prefLabel "recherchieren zu einem chemischen Sachverhalt in unterschiedlichen Quellen,"@de.
n0:z9u
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "K 2";
	skos:broader n0:p4b;
	skos:prefLabel "wählen themenbezogene und aussagekräftige Informationen aus,"@de.
n0:p4h
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "K 3";
	skos:broader n0:p4b;
	skos:prefLabel "prüfen Darstellungen in Medien hinsichtlich ihrer fachlichen Richtigkeit,"@de.
n0:p3c
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "K 4";
	skos:broader n0:p4b;
	skos:prefLabel "beschreiben, veranschaulichen oder erklären chemische Sachverhalte unter Verwendung der Fachsprache und/oder mit Hilfe von Modellen und Darstellungen,"@de.
n0:b6g
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "K 5";
	skos:broader n0:p4b;
	skos:prefLabel "stellen Zusammenhänge zwischen chemischen Sachverhalten und Alltagserscheinungen her und übersetzen dabei bewusst Fachsprache in Alltagssprache und umgekehrt,"@de.
n0:z7y
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "K 6";
	skos:broader n0:p4b;
	skos:prefLabel "protokollieren den Verlauf und die Ergebnisse von Untersuchungen und Diskussionen in angemessener Form,"@de.
n0:a4u
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "K 7";
	skos:broader n0:p4b;
	skos:prefLabel "dokumentieren und präsentieren den Verlauf und die Ergebnisse ihrer Arbeit situationsgerecht und adressatenbezogen,"@de.
n0:x7b
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "K 8";
	skos:broader n0:p4b;
	skos:prefLabel "argumentieren fachlich korrekt und folgerichtig,"@de.
n0:y3s
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "K 9";
	skos:broader n0:p4b;
	skos:prefLabel "vertreten ihre Standpunkte zu chemischen Sachverhalten und reflektieren Einwände selbstkritisch,"@de.
n0:p6a
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "K 10";
	skos:broader n0:p4b;
	skos:prefLabel "planen, strukturieren, reflektieren und präsentieren ihre Arbeit als Team."@de.
n0:p4b
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "K ";
	skos:topConceptOf n0:;
	skos:prefLabel "Kommunikation"@de; 
	skos:definition """Informationen sach- und fachbezogen erschließen und austauschen.\n\nDie Schülerinnen und Schüler ..."""@de;
