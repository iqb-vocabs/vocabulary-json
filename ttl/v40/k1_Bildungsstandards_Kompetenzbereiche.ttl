		n0:z7y,
		n0:a4u,
		n0:x7b,
		n0:y3s,
		n0:p6a.
n0:h6g
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "B 1";
	skos:broader n0:u4h;
	skos:prefLabel "stellen Anwendungsbereiche und Berufsfelder dar, in denen chemische Kenntnisse bedeutsam sind,"@de.
n0:e3e
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "B 2";
	skos:broader n0:u4h;
	skos:prefLabel "erkennen Fragestellungen, die einen engen Bezug zu anderen Unterrichtsfächern aufweisen und zeigen diese Bezüge auf,"@de.
n0:d6t
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "B 3";
	skos:broader n0:u4h;
	skos:prefLabel "nutzen fachtypische und vernetzte Kenntnisse und Fertigkeiten, um lebenspraktisch bedeutsame Zusammenhänge zu erschließen,"@de.
n0:e4x
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "B 4";
	skos:broader n0:u4h;
	skos:prefLabel "entwickeln aktuelle, lebensweltbezogene Fragestellungen, die unter Nutzung fachwissenschaftlicher Erkenntnisse der Chemie beantwortet werden können,"@de.
n0:p3g
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "B 5";
	skos:broader n0:u4h;
	skos:prefLabel "diskutieren und bewerten gesellschaftsrelevante Aussagen aus unterschiedlichen Perspektiven,"@de.
n0:f7f
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "B 6";
	skos:broader n0:u4h;
	skos:prefLabel "binden chemische Sachverhalte in Problemzusammenhänge ein, entwickeln Lösungsstrategien und wenden diese an."@de.
n0:u4h
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "B ";
	skos:topConceptOf n0:;
	skos:prefLabel "Bewertung"@de; 
	skos:definition """Chemische Sachverhalte in verschiedenen Kontexten erkennen und bewerten.\nDie Schülerinnen und Schüler ..."""@de;
	skos:narrower n0:h6g,
		n0:e3e,
		n0:d6t,
		n0:e4x,
		n0:p3g,
		n0:f7f.
n0:
	a skos:ConceptScheme;
	dct:creator "IQB - Institut zur Qualitätsentwicklung im Bildungswesen"@de;
	dct:title "Bildungsstandards Chemie MSA 2004 - Standards (Kompetenzen)"@de;
	dct:description """Mit dem Erwerb des Mittleren Schulabschlusses verfügen die Schülerinnen und Schüler über naturwissenschaftliche Kompetenzen im Allgemeinen sowie chemische Kompetenzen im Besonderen.

 Kompetenzen sind nach Weinert (2001) ,die bei Individuen verfügbaren oder durch sie erlernbaren kognitiven Fähigkeiten und Fertigkeiten, um bestimmte Probleme zu lösen, sowie die damit verbundenen motivationalen, volitionalen und sozialen Bereitschaften und Fähigkeiten, um die Problemlösungen in variablen Situationen erfolgreich und verantwortungsvoll nutzen zu können'. Die Kompetenzen, die eine naturwissenschaftliche Grundbildung ausmachen, bieten Anknüpfungspunkte für fachübergreifendes und fächerverbindendes Arbeiten. Sie werden ohne Berücksichtigung ihrer Vernetzung vier Bereichen zugeordnet und für das Fach Chemie spezifiziert:"""@de;
	dct:license <https://creativecommons.org/publicdomain/zero/1.0/deed.de>;
	skos:hasTopConcept
		n0:x4q,
		n0:z6x,
		n0:p4b,
		n0:u4h.