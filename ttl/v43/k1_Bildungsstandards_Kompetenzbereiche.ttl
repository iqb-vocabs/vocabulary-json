	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "E 6";
	skos:broader n0:y5p;
	skos:prefLabel "planen einfache Experimente, führen die Experimente durch und/oder werten sie aus,"@de.
n0:g6h
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "E 7";
	skos:broader n0:y5p;
	skos:prefLabel "wenden Schritte aus dem experimentellen Weg der Erkenntnisgewinnung zur Erklärung an,"@de.
