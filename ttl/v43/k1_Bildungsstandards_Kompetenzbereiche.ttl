	skos:inScheme n0:;
	skos:notation "K 3";
	skos:broader n0:u2x;
	skos:prefLabel "veranschaulichen Daten messbarer Größen zu Systemen, Struktur und Funktion sowie Entwicklung angemessen mit sprachlichen, mathematischen oder bildlichen Gestaltungsmitteln,"@de.
n0:z7g
