n0:z4s
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "4.2.1";
	skos:broader n0:t4b;
	skos:prefLabel "aus einem breiten Spektrum eine Textsorte auswählen, in eigenen Textproduktionen situationsangemessen und adressatengerecht umsetzen und dabei die Konventionen der jeweiligen Textsorte beachten"@de.
n0:v2s
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "4.2.2";
	skos:broader n0:t4b;
	skos:prefLabel "bei der Textgestaltung funktionale Gesichtspunkte, z. B. Leserlenkung und Fokussierung, beachten"@de.
n0:v4c
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "4.2.3";
	skos:broader n0:t4b;
	skos:prefLabel "literarische und nicht-literarische Textvorlagen transformieren, z. B. einen historischen Text in einen modernen Text umwandeln, einen Text mit fachsprachlichen Elementen für eine andere Zielgruppe adaptieren"@de.
n0:t4b
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "4.2";
	skos:broader n0:u9g;
	skos:prefLabel "Erhöhtes Niveau"@de; 
	skos:definition "Die Schülerinnen und Schüler können darüber hinaus"@de;
	skos:narrower n0:z4s,
		n0:v2s,
		n0:v4c.
n0:u9g
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "4";
	skos:topConceptOf n0:;
	skos:prefLabel "Schreiben"@de; 
	skos:definition "Die Schülerinnen und Schüler können Texte zu einem breiten Spektrum von Themen des fachlichen und persönlichen Interesses adressatengerecht und textsortenspezifisch verfassen. Sie verfügen über Techniken und Strategien des formellen, informellen und kreativen Schreibens."@de;
	skos:narrower n0:g2t,
		n0:t4b.
n0:e2q
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "5.1.1";
	skos:broader n0:d3q;
	skos:prefLabel "Informationen adressatengerecht und situationsangemessen in der jeweils anderen Sprache zusammenfassend wiedergeben"@de.
n0:q6v
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "5.1.2";
	skos:broader n0:d3q;
	skos:prefLabel "interkulturelle Kompetenz und entsprechende kommunikative Strategien einsetzen, um adressatenrelevante Inhalte und Absichten in der jeweils anderen Sprache zu vermitteln"@de.
n0:t7v
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "5.1.3";
	skos:broader n0:d3q;
	skos:prefLabel "bei der Vermittlung von Informationen gegebenenfalls auf Nachfragen eingehen"@de.
n0:p6t
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "5.1.4";
	skos:broader n0:d3q;
	skos:prefLabel "Inhalte unter Nutzung von Hilfsmitteln, wie z. B. Wörterbüchern, durch Kompensationsstrategien, wie z. B. Paraphrasieren, und gegebenenfalls Nutzung von Gestik und Mimik adressatengerecht und situationsangemessen sinngemäß übertragen"@de.
n0:d3q
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "5.1";
	skos:broader n0:d5d;
	skos:prefLabel "Grundlegendes Niveau"@de; 
	skos:definition "Die Schülerinnen und Schüler können mündlich und schriftlicn"@de;
	skos:narrower n0:e2q,
		n0:q6v,
		n0:t7v,
		n0:p6t.
n0:a3d
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "5.2.1";
	skos:broader n0:t5d;
	skos:prefLabel "für das Verstehen erforderliche Erläuterungen hinzufügen"@de.
n0:s6f
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "5.2.2";
	skos:broader n0:t5d;
	skos:prefLabel "zur Bewältigung der Sprachmittlung kreativ mit den beteiligten Sprachen umgehen"@de.
n0:t5d
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "5.2";
	skos:broader n0:d5d;
	skos:prefLabel "Erhöhtes Niveau"@de; 
	skos:definition "Die Schülerinnen und Schüler können darüber hinaus"@de;
	skos:narrower n0:a3d,
		n0:s6f.
n0:d5d
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "5";
	skos:topConceptOf n0:;
	skos:prefLabel "Sprachmittlung"@de; 
	skos:definition "Die Schülerinnen und Schüler können – auch unter Verwendung von Hilfsmitteln und Strategien – wesentliche Inhalte authentischer mündlicher oder schriftlicher Texte, auch zu weniger vertrauten Themen, in der jeweils anderen Sprache sowohl schriftlich als auch mündlich adressatengerecht und situationsangemessen für einen bestimmten Zweck wiedergeben."@de;
	skos:narrower n0:d3q,
		n0:t5d.
n0:e7y
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "6.1";
	skos:broader n0:e4x;
	skos:prefLabel "einen erweiterten allgemeinen und thematischen Wortschatz sowie einen Funktions- und Interpretationswortschatz nutzen"@de.
n0:x9c
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "6.2";
	skos:broader n0:e4x;
	skos:prefLabel "ihre lexikalischen Bestände kontextorientiert und vernetzt verwenden und dabei auch Wörter und Wendungen aus dem Bereich informeller mündlicher Sprachverwendung einsetzen"@de.
n0:p9r
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "6.3";
	skos:broader n0:e4x;
	skos:prefLabel "ein gefestigtes Repertoire der grundlegenden grammatischen Strukturen für die Realisierung ihrer Sprech- und Schreibabsichten nutzen"@de.
n0:r5y
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "6.4";
	skos:broader n0:e4x;
	skos:prefLabel "ein gefestigtes Repertoire typischer Aussprache- und Intonationsmuster verwenden und dabei eine meist klar verständliche Aussprache und angemessene Intonation zeigen"@de.
n0:y4a
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "6.5";
	skos:broader n0:e4x;
	skos:prefLabel "mit repräsentativen Varietäten der Standardsprache umgehen, wenn klar artikuliert gesprochen wird"@de.
n0:a4g
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "6.6";
	skos:broader n0:e4x;
	skos:prefLabel "ihre erweiterten Kenntnisse zu den Regelmäßigkeiten der Orthografie und Zeichensetzung nutzen und ihren aktiven Wortschatz weitgehend regelkonform verwenden"@de.
n0:c7g
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "6.7";
	skos:broader n0:e4x;
	skos:prefLabel "emotional markierte Sprache identifizieren und einschätzen und auf emotionale Äußerungen angemessen reagieren"@de.
n0:c7c
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "6.8";
	skos:broader n0:e4x;
	skos:prefLabel "(Englisch: rezeptiv) sich auf repräsentative Varietäten einstellen, auch wenn nicht durchgehend artikuliert gesprochen wird"@de.
n0:e4x
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "6";
	skos:topConceptOf n0:;
	skos:prefLabel "Verfügen über sprachliche Mittel"@de; 
	skos:definition """Die sprachlichen Mittel – Wortschatz, Grammatik, Aussprache, Prosodie und Orthografie – sind Kompetenz bildende, funktionale Bestandteile des sprachlichen Systems und der Kommunikation. Die sprachlichen Mittel haben grundsätzlich dienende Funktion, wobei die gelingende Kommunikation im Vordergrund steht. Die Schülerinnen und Schüler greifen bei der Sprachrezeption und -produktion auf ein breites Repertoire lexikalischer, grammatischer, textueller und diskursiver Strukturen zurück, um die Fremdsprache auch als Arbeitssprache in der Auseinandersetzung mit komplexen Sachverhalten zu verwenden.\n\nDie Schülerinnen und Schüler können"""@de;
	skos:narrower n0:e7y,
		n0:x9c,
		n0:p9r,
		n0:r5y,
		n0:y4a,
		n0:a4g,
		n0:c7g,
		n0:c7c.
n0:
	a skos:ConceptScheme;
	dct:creator "IQB - Institut zur Qualitätsentwicklung im Bildungswesen"@de;
	dct:title "Bildungsstandards Fremdsprachen Sek II 2012 - Funktionale kommunikative Kompetenz"@de;
	dct:description """Am Ende der gymnasialen Oberstufe wird von Schülerinnen und Schülern im Bereich der funktionalen kommunikativen Kompetenz das Niveau B2 des GeR (Englisch: in rezeptiven Teilkompetenzen auch das Niveau C1) erwartet. Sprachlicher Orientierungspunkt sind Standardsprache(n) sowie Register, Varietäten und Akzente, deren Färbung ein Verstehen nicht generell behindert. In den Bildungsstandards werden die Teilkompetenzen der funktionalen kommunikativen Kompetenz nach dem Muster des GeR jeweils getrennt aufgeführt. In der Sprachverwendung kommen die einzelnen Kompetenzen hingegen vorwiegend integrativ zum Tragen. Die Schülerinnen und Schüler bringen situationsangemessen thematisches Wissen und interkulturelle Kompetenz ein. 

Zu differenziertem kommunikativem Sprachhandeln gehört der angemessene Gebrauch sprachlicher Mittel – Wortschatz, Grammatik, Aussprache, Prosodie und Orthografie – und kommunikativer Strategien. Sprachliche Mittel und kommunikative Strategien haben in allen Kompetenzbereichen dienende Funktion. Die kommunikativen Strategien sind jeweils bei den sprachlichen Teilkompetenzen mitberücksichtigt, die sprachlichen Mittel im Anschluss an die funktionalen kommunikativen Teilkompetenzen dargestellt."""@de;
