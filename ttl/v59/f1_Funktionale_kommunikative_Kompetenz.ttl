n0:y9x
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "1";
	skos:topConceptOf n0:;
	skos:prefLabel "Hör-/Hörsehverstehen"@de; 
	skos:definition "Die Schülerinnen und Schüler können authentische Hör- und Hörsehtexte verstehen, sofern repräsentative Varietäten der Zielsprache gesprochen werden. Sie können dabei Hauptaussagen und Einzelinformationen entnehmen und diese Informationen in thematische Zusammenhänge einordnen."@de;
	skos:narrower n0:d6b,
		n0:s4q.
n0:t2d
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "2.1.1";
	skos:broader n0:d2x;
	skos:prefLabel "Texte unterschiedlicher Textsorten und Entstehungszeiten erschließen"@de.
n0:c4a
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "2.1.2";
	skos:broader n0:d2x;
	skos:prefLabel "explizite und implizite Aussagen von Texten sowie deren Wirkungspotenzial erkennen und einschätzen"@de.
n0:f7y
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "2.1.3";
	skos:broader n0:d2x;
	skos:prefLabel "Texte und Textteile mit Bezug auf ein spezifisches Leseziel auswählen"@de.
n0:f3q
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "2.1.4";
	skos:broader n0:d2x;
	skos:prefLabel "der Leseabsicht entsprechende Rezeptionsstrategien selbstständig anwenden"@de.
n0:p2v
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "2.1.5";
	skos:broader n0:d2x;
	skos:prefLabel "die Hauptaussagen und deren unterstützende sprachliche und / oder inhaltliche Einzelinformationen erfassen"@de.
n0:h2a
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "2.1.6";
	skos:broader n0:d2x;
	skos:prefLabel "die inhaltliche Struktur eines Textes nachvollziehen und Gestaltungsmerkmale in ihrer Wirkung erfassen"@de.
n0:z5d
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "2.1.7";
	skos:broader n0:d2x;
	skos:prefLabel "die Absicht und Wirkung von Texten in deren zielkulturellen Zusammenhängen erkennen"@de.
n0:c3g
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "2.1.8";
	skos:broader n0:d2x;
	skos:prefLabel "mehrfach kodierte Texte und Textteile, z. B. in Werbeanzeigen, Plakaten, Flugblättern, aufeinander beziehen und in ihrer Einzel- und Gesamtaussage erkennen, analysieren und bewerten"@de.
n0:d2x
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "2.1";
	skos:broader n0:d2t;
	skos:prefLabel "Grundlegendes Niveau"@de; 
	skos:definition "Die Schülerinnen und Schüler können"@de;
	skos:narrower n0:t2d,
		n0:c4a,
		n0:f7y,
		n0:f3q,
		n0:p2v,
		n0:h2a,
		n0:z5d,
		n0:c3g.
n0:q6s
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "2.2.1";
	skos:broader n0:a3h;
	skos:prefLabel "selbstständig (Englisch: komplexe) Texte unterschiedlicher Textsorten und Entstehungszeiten auch zu wenig vertrauten Themen erschließen"@de.
n0:z7r
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "2.2.2";
	skos:broader n0:a3h;
	skos:prefLabel "die inhaltliche Struktur von komplexen Texten erkennen und dabei Gestaltungsmerkmale in ihrer Funktion und Wirkung analysieren"@de.
n0:r5x
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "2.2.3";
	skos:broader n0:a3h;
	skos:prefLabel "die Wirkung von Texten in deren zielkulturellen Zusammenhängen analysieren"@de.
n0:a3h
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "2.2";
	skos:broader n0:d2t;
	skos:prefLabel "Erhöhtes Niveau"@de; 
	skos:definition "Die Schülerinnen und Schüler können darüber hinaus"@de;
	skos:narrower n0:q6s,
		n0:z7r,
		n0:r5x.
n0:d2t
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "2";
	skos:topConceptOf n0:;
	skos:prefLabel "Leseverstehen"@de; 
	skos:definition "Die Schülerinnen und Schüler können authentische Texte auch zu abstrakteren Themen verstehen. Sie können ein umfassendes Textverständnis aufbauen, indem sie Hauptaussagen und Einzelinformationen entnehmen, diese Informationen in thematische Zusammenhänge einordnen, gezielt textinterne Informationen und externes Wissen heranziehen und auch wichtige implizite Aussagen erschließen."@de;
	skos:narrower n0:d2x,
		n0:a3h.
n0:d6y
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "3.1.1";
	skos:broader n0:u2d;
	skos:prefLabel "ein adressatengerechtes und situationsangemessenes Gespräch in der Fremdsprache führen"@de.
n0:d9d
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "3.1.2";
	skos:broader n0:u2d;
	skos:prefLabel "verbale und nicht-verbale Gesprächskonventionen situationsangemessen anwenden, um z. B. ein Gespräch oder eine Diskussion zu eröffnen, auf Aussagen anderer Sprecher einzugehen, sich auf Gesprächspartner einzustellen und ein Gespräch zu beenden"@de.
n0:x5r
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "3.1.3";
	skos:broader n0:u2d;
	skos:prefLabel "angemessene kommunikative Strategien bewusst einsetzen, um mit Nichtverstehen und Missverständnissen umzugehen"@de.
n0:h4g
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "3.1.4";
	skos:broader n0:u2d;
	skos:prefLabel "sich zu vertrauten Themen aktiv an Diskussionen beteiligen sowie eigene Positionen vertreten"@de.
n0:x9u
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "3.1.5";
	skos:broader n0:u2d;
	skos:prefLabel "in informellen und formellen Situationen persönliche Meinungen unter Beachtung kultureller Gesprächskonventionen ausdrücken und begründen"@de.
n0:e9h
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "3.1.6";
	skos:broader n0:u2d;
	skos:prefLabel "zu aktuell bedeutsamen Sachverhalten in Gesprächen oder Diskussionen Stellung nehmen"@de.
n0:u2d
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "3.1";
	skos:broader n0:b7f;
	skos:prefLabel "Grundlegendes Niveau"@de; 
	skos:definition "Die Schülerinnen und Schüler können"@de;
	skos:narrower n0:d6y,
		n0:d9d,
		n0:x5r,
		n0:h4g,
		n0:x9u,
		n0:e9h.
n0:e3q
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "3.2.1";
	skos:broader n0:h6e;
	skos:prefLabel "sich an Diskussionen zu weniger vertrauten Themen aktiv beteiligen, auf differenzierte Äußerungen anderer angemessen reagieren sowie eigene Positionen vertreten"@de.
n0:c9g
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "3.2.2";
	skos:broader n0:h6e;
	skos:prefLabel "ein adressatengerechtes und situationsangemessenes Gespräch in der Fremdsprache führen und sich dabei spontan und weitgehend flüssig äußern"@de.
n0:f5y
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "3.2.3";
	skos:broader n0:h6e;
	skos:prefLabel "zu aktuellen wie generell bedeutsamen Sachverhalten Stellung nehmen und in Diskussionen ggf. verschiedene Positionen sprachlich differenziert formulieren"@de.
n0:h6e
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "3.2";
	skos:broader n0:b7f;
	skos:prefLabel "Erhöhtes Niveau"@de; 
	skos:definition "Die Schülerinnen und Schüler können darüber hinaus"@de;
	skos:narrower n0:e3q,
		n0:c9g,
		n0:f5y.
n0:b7f
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "3";
	skos:topConceptOf n0:;
	skos:prefLabel " Sprechen"@de; 
	skos:definition """An Gesprächen teilnehmen\n\nDie Schülerinnen und Schüler können sich weitgehend flüssig, sprachlich korrekt und adressatengerecht sowie situationsangemessen an Gesprächen beteiligen. Sie sind bereit und in der Lage, in einer gegebenen Sprechsituation zu interagieren, auch wenn abstrakte und in einzelnen Fällen weniger vertraute Themen behandelt werden."""@de;
	skos:narrower n0:u2d,
		n0:h6e.
n0:s2y
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "4.1.1";
	skos:broader n0:g2t;
	skos:prefLabel "Schreibprozesse selbstständig planen, umsetzen und reflektieren"@de.
n0:f5x
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "4.1.2";
	skos:broader n0:g2t;
	skos:prefLabel "Texte in formeller oder persönlich-informeller Sprache verfassen und dabei wesentliche Konventionen der jeweiligen Textsorten beachten"@de.
n0:a2z
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "4.1.3";
	skos:broader n0:g2t;
	skos:prefLabel "Informationen strukturiert und kohärent vermitteln"@de.
n0:s6h
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "4.1.4";
	skos:broader n0:g2t;
	skos:prefLabel "sich argumentativ mit unterschiedlichen Positionen auseinandersetzen"@de.
n0:v5c
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "4.1.5";
	skos:broader n0:g2t;
	skos:prefLabel "Texte zu literarischen und nicht-literarischen Textvorlagen verfassen"@de.
n0:z2y
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "4.1.6";
	skos:broader n0:g2t;
	skos:prefLabel "eigene kreative Texte verfassen, ggf. in Anbindung an eine Textvorlage"@de.
n0:x9z
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "4.1.7";
	skos:broader n0:g2t;
	skos:prefLabel "Textsorten zielorientiert in eigenen Textproduktionen situationsangemessen verwenden"@de.
n0:d4h
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "4.1.8";
	skos:broader n0:g2t;
	skos:prefLabel "diskontinuierliche Vorlagen in kontinuierliche Texte umschreiben"@de.
n0:g2t
	a skos:Concept;
	skos:inScheme n0:;
	skos:notation "4.1";
	skos:broader n0:u9g;
	skos:prefLabel "Grundlegendes Niveau"@de; 
	skos:definition "Die Schülerinnen und Schüler können"@de;
	skos:narrower n0:s2y,
		n0:f5x,
		n0:a2z,
		n0:s6h,
		n0:v5c,
		n0:z2y,
